# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development

# Required in production (32+ characters). In development a fixed insecure secret is used if empty.
JWT_SECRET=

# SQLite file (created on first start)
DATABASE_PATH=./data/nabd.db

# Allowed browser origin for CORS when the frontend is served from a different host.
# Leave empty when using the Vite dev proxy or serving the built frontend from this server.
CORS_ORIGIN=

# WhatsApp: "console" logs messages instead of sending (default for development).
# "cloud" sends through the WhatsApp Business Cloud API.
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_URGENT=blood_request_urgent_v2
WHATSAPP_TEMPLATE_VERIFY=donor_verify_v1
WHATSAPP_TEMPLATE_DRIVE=blood_drive_invite_v1

# Enables /api/admin (create hospital accounts, reset passwords). Leave empty to turn it off.
# Send it as the X-Admin-Token header. 32+ random characters in production.
ADMIN_TOKEN=
