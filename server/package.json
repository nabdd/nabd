{
  "name": "nabd-server",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true});console.log('Database removed. It is recreated and re-seeded on next start.')\"",
    "test": "tsc -p tsconfig.json --noEmit false --outDir dist-test && node --test \"dist-test/test/**/*.test.js\""
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/throttler": "^6.7.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}
